{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/decision-agent-ag-ui-message.schema.json",
  "title": "Decision Agent AG-UI Event Message",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "source_service",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "const": "decision_agent.session.ag_ui_event"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_service": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversation_id",
        "turn_id",
        "message_id",
        "sequence",
        "ag_ui_event"
      ],
      "properties": {
        "conversation_id": {
          "type": "string",
          "minLength": 1
        },
        "turn_id": {
          "type": "string",
          "minLength": 1
        },
        "message_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "ag_ui_event": {
          "type": "object",
          "additionalProperties": true,
          "required": ["type", "eventId", "threadId", "runId", "sequence"],
          "properties": {
            "type": {
              "enum": [
                "RUN_STARTED",
                "RUN_FINISHED",
                "RUN_ERROR",
                "STATE_SNAPSHOT",
                "STATE_DELTA",
                "ACTIVITY_SNAPSHOT",
                "ACTIVITY_DELTA",
                "TOOL_CALL_RESULT"
              ]
            },
            "eventId": {"type": "string", "minLength": 1},
            "threadId": {"type": "string", "minLength": 1},
            "runId": {"type": "string", "minLength": 1},
            "sequence": {"type": "integer", "minimum": 1},
            "state": {"type": "object"},
            "result": {"type": "object"}
          }
        }
      }
    }
  }
}
