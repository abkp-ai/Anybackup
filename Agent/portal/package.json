{
  "name": "agent-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "node ./node_modules/eslint/bin/eslint.js src tests scripts eslint.config.js vite.config.ts playwright.account.config.ts playwright.chat-demo.config.ts playwright.login.config.ts playwright.menu.config.ts playwright.settings-users.config.ts && node scripts/check-naming.mjs",
    "lint:naming": "node scripts/check-naming.mjs",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.app.json",
    "build": "node ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.app.json && node ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:protocol": "vitest run src/services/conversation-service.test.ts src/services/conversation-response-adapter.test.ts src/store/conversation-runtime.test.ts src/store/useConversationStore.test.ts",
    "visual:menu": "playwright test -c playwright.menu.config.ts",
    "visual:menu:headed": "playwright test -c playwright.menu.config.ts --headed",
    "visual:account": "node scripts/run-visual-account.mjs",
    "visual:account:headed": "node scripts/run-visual-account.mjs --headed",
    "visual:login": "node scripts/run-visual-login.mjs",
    "visual:login:headed": "node scripts/run-visual-login.mjs --headed",
    "visual:login:update": "node scripts/run-visual-login.mjs --update-baseline",
    "visual:chat-demo": "node scripts/run-visual-chat-demo.mjs",
    "visual:chat-demo:headed": "node scripts/run-visual-chat-demo.mjs --headed",
    "visual:chat-demo:update": "node scripts/run-visual-chat-demo.mjs --update-baseline",
    "visual:settings-users": "node scripts/run-visual-settings-users.mjs",
    "visual:settings-users:headed": "node scripts/run-visual-settings-users.mjs --headed",
    "visual:settings-users:update": "node scripts/run-visual-settings-users.mjs --update-baseline",
    "gate:frontend": "npm run lint && npm run typecheck && npm run test:protocol && npm run test -- src/pages/SettingsPage.test.tsx src/pages/UserManagementPage.test.tsx && npm run visual:login && npm run visual:account && npm run visual:chat-demo && npm run visual:settings-users && npm run build"
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.53",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "github-markdown-css": "^5.9.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.1.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.0",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "globals": "^15.15.0",
    "jsdom": "26.1.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.4"
  }
}
